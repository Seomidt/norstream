{
  "expo": {
    "name": "NorStream",
    "slug": "iptv-norlys",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dk.seomidt.norstream"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dk.seomidt.norstream",
      "versionCode": 265,
      "permissions": [
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "@react-native-tvos/config-tv",
        {
          "isTV": false,
          "tvosDeploymentTarget": "16.4",
          "androidTVBanner": "./assets/tv-banner.png"
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "NorStream bruger kameraet til at scanne QR-koden fra tv'et, når du sender en sikkerhedskopi."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "5402f189-eb55-406e-8b63-217bf4511df3"
      }
    },
    "owner": "seomidts-team"
  }
}
